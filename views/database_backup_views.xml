<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================================
         BACKUP JOB - LIST VIEW
         ========================================================== -->

    <record id="view_odoo_database_backup_list" model="ir.ui.view">
        <field name="name">odoo.database.backup.list</field>
        <field name="model">odoo.database.backup</field>
        <field name="arch" type="xml">
            <list string="Database Backup Jobs">
                <field name="name"/>
                <field name="database_name"/>
                <field name="storage_id"/>
                <field name="schedule_type"/>
                <field name="include_filestore"/>
                <field name="state"/>
                <field name="backup_date"/>
                <field name="next_run"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ==========================================================
         BACKUP JOB - FORM VIEW
         ========================================================== -->

    <record id="view_odoo_database_backup_form" model="ir.ui.view">
        <field name="name">odoo.database.backup.form</field>
        <field name="model">odoo.database.backup</field>
        <field name="arch" type="xml">

            <form string="Database Backup">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed"/>
                    <button name="action_start" string="Start" type="object" class="btn-primary" invisible="state == 'running'" icon="fa-play"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="Backup Job Name"
                            />
                        </h1>
                    </div>

                    <group>
                        <group string="Database">
                            <field name="database_name"/>
                            <field name="include_filestore"/>
                            <field name="active"/>
                        </group>

                        <group string="Backup Service">
                            <field name="storage_id"/>
                            <field name="state" readonly="1"/>
                            <field name="backup_date" readonly="1"/>
                        </group>
                    </group>

                        <group string="Schedule">
                            <field name="active"/>
                            <field name="schedule_type"/>
                            <field name="schedule_hour" invisible="schedule_type not in ['daily', 'weekly', 'monthly']"/>
                            <field name="schedule_minute" invisible="schedule_type not in ['daily', 'weekly', 'monthly']"/>
                            <field name="schedule_weekday" invisible="schedule_type != 'weekly'"/>
                            <field name="schedule_day" invisible="schedule_type != 'monthly'"/>
                        </group>

                        <group string="Execution">
                            <field name="last_run"/>
                            <field name="next_run"/>
                        </group>

                    <notebook>
                        <page string="Backup Files">
                            <field name="backup_file_ids" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="database_name"/>
                                    <field name="backup_filename"/>
                                    <field name="file_size"/>
                                    <field name="media"/>
                                    <field name="state"/>
                                    <field name="backup_date"/>
                                    <button name="action_download" type="object" string="Download" icon="fa-download" class="btn-primary" invisible="not backup_file or state != 'success'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
            </form>
        </field>
    </record>

    <record id="action_odoo_database_backup" model="ir.actions.act_window">
        <field name="name">Database Backup Jobs</field>
        <field name="res_model">odoo.database.backup</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>